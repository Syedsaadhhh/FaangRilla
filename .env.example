# OpenDoor Relay Environment Configuration (Placeholders Only)
# Copy to .env for local overrides. Never commit actual credentials or secrets.

# AWS Configuration (Run 3+)
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
AWS_CLI_PROFILE=default

# Amazon Bedrock (Run 2+)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Amazon SES Verified Inboxes (Run 3+)
SES_FROM_EMAIL=notifications@example.com
PROVIDER_A_EMAIL=provider-a@example.com
PROVIDER_B_EMAIL=provider-b@example.com

# Public & Application URLs
GITHUB_REPO_URL=https://github.com/example/opendoor-relay
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000

# Devpost Submitter Metadata
AWS_BUILDER_ID_EMAIL=builder@example.com
